# ============================================================
# SK Binge Galaxy — Environment Variables
# Copy this file to .env and update values for your environment
# NEVER commit .env to version control.
# ============================================================

# ── Database ──────────────────────────────────────────────────
POSTGRES_PASSWORD=          # REQUIRED — PostgreSQL password for skbg_admin
MONGO_PASSWORD=             # REQUIRED — MongoDB root password

# ── Service Discovery ────────────────────────────────────────
EUREKA_PASSWORD=            # REQUIRED — Eureka Basic Auth password

# ── Config Server ────────────────────────────────────────────
CONFIG_SERVER_USER=configuser
CONFIG_SERVER_PASSWORD=     # REQUIRED — Spring Cloud Config password

# ── JWT ───────────────────────────────────────────────────────
# Base64-encoded HMAC-SHA256 key (min 256 bits / 32 bytes)
JWT_SECRET=                 # REQUIRED — generate with: openssl rand -base64 32

# ── Internal Service-to-Service Auth ──────────────────────────
INTERNAL_API_SECRET=        # REQUIRED — shared secret for Feign calls: openssl rand -hex 32

# ── Deploy / Ingress ──────────────────────────────────────────
INGRESS_HOST=skbingegalaxy.com
TLS_SECRET_NAME=skbingegalaxy-tls
LETSENCRYPT_EMAIL=admin@skbingegalaxy.com
STORAGE_CLASS_NAME=         # REQUIRED for Kubernetes stateful workloads

# ── Auth Cookies ──────────────────────────────────────────────
COOKIE_SECURE=true           # Set to false only for local HTTP development
COOKIE_DOMAIN=               # Set to your production domain when using ingress

# ── Admin Seeding ─────────────────────────────────────────────
ADMIN_EMAIL=admin@skbingegalaxy.com
ADMIN_PASSWORD=             # REQUIRED — strong initial admin password

# ── Google OAuth ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=           # REQUIRED — Google OAuth 2.0 client ID

# ── Payment ───────────────────────────────────────────────────
RAZORPAY_KEY_ID=            # REQUIRED — Razorpay API key ID (rzp_live_* in production)
RAZORPAY_KEY_SECRET=        # REQUIRED — Razorpay API key secret
RAZORPAY_WEBHOOK_SECRET=    # REQUIRED — webhook signing secret (disputes + refund settlement)

# ── Stripe Connect (optional) ────────────────────────────────────────────────
# Leave STRIPE_SECRET_KEY empty to keep Stripe dormant — the provider then
# advertises no currencies and payments continue to route to Razorpay only.
# Enable it to accept venues whose currency Razorpay cannot settle, and to give
# each venue its own connected account (direct charges in the venue's country,
# which is what makes venue-local rails like UPI work for foreign customers).
STRIPE_SECRET_KEY=          # sk_live_* in production
STRIPE_PUBLISHABLE_KEY=     # pk_live_* — sent to the browser to init Stripe.js
STRIPE_WEBHOOK_SECRET=      # whsec_* — REQUIRED when Stripe is enabled, else
                            # every webhook is rejected 403 and connected
                            # accounts never flip to chargeable after KYC
STRIPE_APPLICATION_FEE_BPS=0   # platform commission in basis points (100 = 1%)
STRIPE_ONBOARDING_RETURN_URL=  # where Stripe returns the owner after onboarding
STRIPE_ONBOARDING_REFRESH_URL=

# ── Secret encryption ────────────────────────────────────────────────────────
# AES-256 key (base64, exactly 32 bytes) that encrypts TOTP/MFA secrets at rest.
# Generate with: openssl rand -base64 32
# If empty, the key is DERIVED from JWT_SECRET — encryption still applies, but
# rotating JWT_SECRET would make every enrolled TOTP secret undecryptable.
CRYPTO_SECRET_KEY=          # STRONGLY RECOMMENDED before enrolling users
TOTP_MAX_FAILED_ATTEMPTS=5  # failed 2FA codes before a temporary lock
TOTP_LOCK_MINUTES=15
PAYMENT_CALLBACK_URL=       # e.g. https://yourdomain.com/api/v1/payments/callback
# DANGER: when true the payment service confirms bookings WITHOUT charging money.
# Local development only. A production-profile boot FAILS if this is true
# (PaymentService.validateConfig), and it must never be set outside compose dev.
PAYMENT_SIMULATION_ENABLED=false

# ── Browser Web Push (VAPID) ──────────────────────────────────
# Generate ONCE per deployment with: npx web-push generate-vapid-keys
# The public key must stay stable (rotating invalidates every subscription).
# No config default exists — notification-service fails to boot without these.
WEBPUSH_PUBLIC_KEY=         # REQUIRED
WEBPUSH_PRIVATE_KEY=        # REQUIRED — secret, never commit

# ── CORS (comma-separated origins) ───────────────────────────
CORS_ALLOWED_ORIGINS=https://skbingegalaxy.com  # Add http://localhost:3000 only for local dev

# ── Email / SMTP ──────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=                 # SMTP username
EMAIL_PASS=                 # SMTP password / app-specific password
EMAIL_FROM=noreply@skbingegalaxy.com

# ── SMS / WhatsApp ────────────────────────────────────────────
SMS_PROVIDER=disabled        # Use a real provider name only after integration exists
SMS_API_KEY=
WHATSAPP_PROVIDER=disabled   # Use a real provider name only after integration exists
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
