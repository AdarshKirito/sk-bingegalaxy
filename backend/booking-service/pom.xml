  </parent>
  <artifactId>booking-service</artifactId>
  <name>Booking Service</name>
  <description>Booking, event types, add-ons, and pricing</description>

  <properties>
    <!-- COVERAGE RATCHET override — a measured baseline, not a target.
         Measured 2026-08-01: 0.28 line / 0.22 branch (floors set 1 point lower so
         display rounding cannot cause a false failure).
         This is the largest module — 392 files including a 5,189-line service class
         the audit names as the main source of regressions. Reaching the 0.60/0.50
         target here is a programme of work, not a quick fix; the ratchet exists so
         that work is protected as it lands.
         You may RAISE these; never lower them. See backend/pom.xml. -->
    <jacoco.min.line>0.27</jacoco.min.line>
    <jacoco.min.branch>0.21</jacoco.min.branch>
  </properties>
  <dependencies>
