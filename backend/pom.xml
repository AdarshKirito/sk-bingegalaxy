<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.5</version>
        <relativePath/>
    </parent>

    <groupId>com.skbingegalaxy</groupId>
    <artifactId>sk-binge-galaxy</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>SK Binge Galaxy</name>
    <description>Private theater booking platform — microservices backend</description>

    <modules>
        <module>common-lib</module>
        <module>discovery-server</module>
        <module>config-server</module>
        <module>api-gateway</module>
        <module>auth-service</module>
        <module>availability-service</module>
        <module>booking-service</module>
        <module>payment-service</module>
        <module>notification-service</module>
        <!--
          Distribution bounded context (design 05-DISTRIBUTION-CONSOLE-DESIGN-V2 §13 G-A).
          Owns connections, destinations, listing mappings, the reservation inbox,
          settlements, sync state and provider health — and NOTHING else. It holds no
          availability rows and no booking rows: those truths stay in
          availability-service and booking-service respectively.
        -->
        <module>distribution-service</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <spring-cloud.version>2024.0.1</spring-cloud.version>
        <jjwt.version>0.12.5</jjwt.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <lombok.version>1.18.38</lombok.version>
        <mockito.version>5.14.2</mockito.version>
        <byte-buddy.version>1.15.10</byte-buddy.version>
        <springdoc.version>2.5.0</springdoc.version>

        <!--
          Coverage ratchet floors — see the jacoco `check` execution below for the
          contract. These are the TARGET every module should reach. Modules below it
          today override these properties in their own pom with their measured
          baseline, so the gate prevents regression instead of being unenforceable.

          Measured 2026-08-01 (`mvn verify`, whole reactor).
          Format: module = measured line / measured branch -> ratchet floor

            common-lib           = meets target        -> no override
            api-gateway          = meets target        -> no override
            availability-service = 0.55 / 0.43         -> 0.54 / 0.42
                                   closest to target; smallest job to finish
            notification-service = 0.44 / 0.29         -> 0.43 / 0.28
            payment-service      = 0.30 / 0.20         -> 0.29 / 0.19
                                   prioritise: it moves money, PR-PAY-01 still open
            auth-service         = 0.28 / 0.21         -> 0.27 / 0.20
            booking-service      = 0.28 / 0.22         -> 0.27 / 0.21
                                   392 files incl. a 5,189-line service class

          Floors sit one point below the measured value so JaCoCo's 2-dp display
          rounding can never cause a false failure.
        -->
        <jacoco.min.line>0.60</jacoco.min.line>
        <jacoco.min.branch>0.50</jacoco.min.branch>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.skbingegalaxy</groupId>
                <artifactId>common-lib</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-brave</artifactId>
        </dependency>
        <dependency>
            <groupId>io.zipkin.reporter2</groupId>
            <artifactId>zipkin-reporter-brave</artifactId>
        </dependency>
        <!-- Structured JSON logging for centralized log aggregation (EFK/ELK) -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>8.0</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <fork>true</fork>
                    <!-- Forked javac JVM memory limits — .mvn/jvm.config only controls the
                         Maven launcher, not this separate process. Without explicit limits the
                         OS default applies, which is too small for Lombok + MapStruct + Spring
                         Boot autoconfigure metadata on modules with large dependency graphs. -->
                    <meminitial>128m</meminitial>
                    <maxmem>512m</maxmem>
                    <compilerArgs>
                        <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED</arg>
                        <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED</arg>
                        <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED</arg>
                        <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.main=ALL-UNNAMED</arg>
                        <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.model=ALL-UNNAMED</arg>
                        <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED</arg>
                        <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.processing=ALL-UNNAMED</arg>
                        <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED</arg>
                        <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED</arg>
                    </compilerArgs>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>
                        ${jacoco.surefire.argline}
                        --add-opens java.base/java.lang=ALL-UNNAMED
                        --add-opens java.base/java.lang.reflect=ALL-UNNAMED
                        --add-opens java.base/java.util=ALL-UNNAMED
                    </argLine>
                    <!--
                      Surefire's default is to SIGKILL the forked JVM 30 seconds after
                      System.exit(0). That deadline races the JaCoCo agent, which writes
                      jacoco.exec from a JVM shutdown hook and takes longer the more
                      classes it has instrumented — booking-service is the largest module
                      and reliably trips it on a loaded machine:

                        [ERROR] Surefire is going to kill self fork JVM.
                                The exit has elapsed 30 seconds after System.exit(0).

                      This is not cosmetic. jacoco:check runs at `verify` and FAILS the
                      build below 60% line / 50% branch coverage; a truncated jacoco.exec
                      yields artificially low numbers, so the gate fails for reasons that
                      have nothing to do with the code — a flaky, load-dependent failure
                      that looks like a coverage regression.

                      Raising the deadline lets the dump finish. It costs nothing on a fast
                      exit: this is a ceiling, not a sleep.
                    -->
                    <forkedProcessExitTimeoutInSeconds>300</forkedProcessExitTimeoutInSeconds>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <!-- Injects the JaCoCo agent into Surefire's JVM. The property
                         ${jacoco.surefire.argline} is consumed by maven-surefire-plugin above. -->
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                        <configuration>
                            <propertyName>jacoco.surefire.argline</propertyName>
                            <!--
                              append=false: start a FRESH jacoco.exec each run.

                              JaCoCo appends by default, which turns a single truncated
                              write into a permanent problem: any run interrupted while
                              the agent is dumping (CI cancelled, container killed, OOM)
                              leaves a partial file that every LATER build then appends
                              to and chokes on, with errors that point nowhere useful:

                                Error while creating report: Unknown block type 66
                                Error while creating report: malformed input around byte 2

                              Both were observed here. The only recovery is to delete
                              every target/jacoco.exec by hand — a booby trap for anyone
                              who does not know that.

                              Nothing is lost by starting fresh: `verify` re-runs the
                              tests, so the gate should measure THIS run rather than an
                              accumulation across runs. Combined with the raised
                              forkedProcessExitTimeoutInSeconds above (which stops the
                              truncation happening in the first place), this makes a
                              corrupt exec self-healing instead of sticky.
                            -->
                            <append>false</append>
                        </configuration>
                    </execution>
                    <!-- Generates HTML + XML reports under target/site/jacoco/ -->
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                    <!--
                      COVERAGE RATCHET.

                      These minimums were previously hard-coded at 0.60/0.50 — an
                      aspiration nobody had measured. Four of seven modules do not meet
                      it, so `mvn verify` failed for anyone who ran it. Nobody noticed
                      because CI only ran `mvn test` and `package -DskipTests`, neither
                      of which reaches the `verify` phase this is bound to. A gate that
                      never executes is not a gate.

                      Rather than delete the gate or silently lower it to make the build
                      green, the thresholds are now PROPERTIES, defaulted to the target
                      and overridden per module to each module's MEASURED baseline
                      (see each module's pom). That makes the gate meaningful today: it
                      cannot catch up to an aspiration, but it can stop coverage from
                      going BACKWARDS, which is the failure that actually matters.

                      THE CONTRACT — read before touching a module's override:
                        * You may RAISE a module's threshold, never lower it.
                        * If your change drops coverage, the build fails. Add tests.
                          Do not "fix" it by editing the number.
                        * Raise the override whenever real coverage moves up, so the
                          new level is locked in.
                      Target for every module remains 0.60 line / 0.50 branch.
                    -->
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.min.line}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.min.branch}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                            <!-- Exclude generated / framework boilerplate from coverage counts -->
                            <excludes>
                                <exclude>**/config/**</exclude>
                                <exclude>**/*Application.class</exclude>
                                <exclude>**/dto/**</exclude>
                                <exclude>**/entity/**</exclude>
                                <exclude>**/exception/**</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- K8s profile: replaces Eureka with native Kubernetes service discovery -->
    <profiles>
        <profile>
            <id>kubernetes</id>
            <dependencies>
                <dependency>
                    <groupId>org.springframework.cloud</groupId>
                    <artifactId>spring-cloud-starter-kubernetes-client</artifactId>
                </dependency>
                <dependency>
                    <groupId>org.springframework.cloud</groupId>
                    <artifactId>spring-cloud-starter-kubernetes-client-config</artifactId>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
